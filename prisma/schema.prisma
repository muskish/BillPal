generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Freelancer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("freelancers")
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String
  company   String?
  createdAt DateTime  @default(now()) @map("created_at")
  projects  Project[]
  payments  Payment[]

  @@map("clients")
}

model Project {
  id          String      @id @default(cuid())
  clientId    String      @map("client_id")
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String?
  totalAmount Int         @map("total_amount") // stored in integer cents (decimal-safe)
  currency    String      @default("USD")
  status      String      @default("active") // active, completed, on_hold
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  createdAt   DateTime    @default(now()) @map("created_at")
  milestones  Milestone[]
  payments    Payment[]
  tasks       Task[]

  @@map("projects")
}

model Milestone {
  id              String    @id @default(cuid())
  projectId       String    @map("project_id")
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  amount          Int       // cents
  dueDate         DateTime  @map("due_date")
  status          String    @default("planned") // planned, payment_pending, paid, late
  paypalOrderId   String?   @map("paypal_order_id")
  paypalCaptureId String?   @map("paypal_capture_id")
  payments        Payment[]
  tasks           Task[]

  @@map("milestones")
}

model Payment {
  id              String    @id @default(cuid())
  clientId        String    @map("client_id")
  client          Client    @relation(fields: [clientId], references: [id])
  projectId       String    @map("project_id")
  project         Project   @relation(fields: [projectId], references: [id])
  milestoneId     String    @map("milestone_id")
  milestone       Milestone @relation(fields: [milestoneId], references: [id])
  paypalOrderId   String    @map("paypal_order_id")
  paypalCaptureId String?   @map("paypal_capture_id")
  amount          Int       // cents
  currency        String    @default("USD")
  status          String    // CREATED, APPROVED, COMPLETED, FAILED
  approvalUrl     String?   @map("approval_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  paidAt          DateTime? @map("paid_at")

  @@map("payments")
}

model WebhookEvent {
  id               String    @id @default(cuid())
  paypalEventId    String    @unique @map("paypal_event_id")
  eventType        String    @map("event_type")
  resourceId       String?   @map("resource_id")
  processingStatus String    @default("pending") @map("processing_status") // pending, processed, failed, ignored_duplicate
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")
  errorMessage     String?   @map("error_message")

  @@map("webhook_events")
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Int      // cents
  dueDate     DateTime @map("due_date")
  category    String   // rent, software, contractor, tax, misc
  isSeeded    Boolean  @default(true) @map("is_seeded")

  @@map("expenses")
}

model CashAccount {
  id             String @id @default(cuid())
  label          String
  openingBalance Int    @map("opening_balance") // cents
  currency       String @default("USD")

  @@map("cash_accounts")
}

model Task {
  id                 String     @id @default(cuid())
  projectId          String     @map("project_id")
  project            Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId        String?    @map("milestone_id")
  milestone          Milestone? @relation(fields: [milestoneId], references: [id])
  title              String
  startDate          DateTime   @map("start_date")
  endDate            DateTime   @map("end_date")
  priority           String     @default("medium") // high, medium, low
  status             String     @default("todo") // todo, in_progress, completed, delayed
  isPaymentDependent Boolean    @default(false) @map("is_payment_dependent")

  @@map("tasks")
}

model ScheduleProposal {
  id           String    @id @default(cuid())
  reason       String
  proposalJson String    @map("proposal_json") // JSON string of task adjustments
  status       String    @default("pending") // pending, approved, rejected
  createdAt    DateTime  @default(now()) @map("created_at")
  approvedAt   DateTime? @map("approved_at")

  @@map("schedule_proposals")
}

